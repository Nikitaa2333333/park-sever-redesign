---
import { site, withBase } from '../lib/content';
import '../styles/design-system.css';
const { title } = Astro.props;
const booking = site.integrations.booking;
// Инициализация виджета брони: НЕ ждём window.load (он зависает на догрузке hero-видео).
// Стартуем по DOMContentLoaded и опрашиваем готовность znmsWidget (скрипт грузится async).
// Как только виджет добавит свой DOM — убираем скелетон-заглушку.
const initJs = `(function(){
  var c=${JSON.stringify(booking.container)},cfg=${JSON.stringify(booking.initConfig)};
  function ready(fn){if(document.readyState!=='loading')fn();else document.addEventListener('DOMContentLoaded',fn);}
  ready(function(){
    var el=document.querySelector(c);
    if(el){var obs=new MutationObserver(function(){
      var sk=el.querySelector('.znms-skeleton');
      var hasW=Array.prototype.some.call(el.children,function(x){return !(x.classList&&x.classList.contains('znms-skeleton'));});
      if(hasW&&sk){sk.remove();obs.disconnect();}
    });obs.observe(el,{childList:true});}
    else{
      // Подстраницы: инлайн-формы hero нет. Виджету всё равно нужен контейнер, чтобы
      // инициализироваться — без него ни open(), ни deep-link (?znms_widget_open) не
      // сработают, и «Забронировать» в шапке не открывается. Создаём скрытый off-screen:
      // инлайн-форма не видна, а модуль open() всплывает как обычный оверлей.
      el=document.createElement('div');el.id=c.replace(/^#/,'');
      el.style.cssText='position:absolute;left:-9999px;top:0;width:1px;height:1px;overflow:hidden;';
      document.body.appendChild(el);
    }
    var t=0;(function tryInit(){t++;
      if(window.znmsWidget&&window.znmsWidget.init){try{window.znmsWidget.init(c,cfg);}catch(e){console.warn('znms widget:',e);}return;}
      if(t<120)setTimeout(tryInit,50);
    })();
    // Все CTA «Забронировать» (ссылки ?znms_widget_open) открывают модуль без перезагрузки.
    // Если виджет ещё не готов — не мешаем: браузер уходит по href, и deep-link сработает
    // на загрузке. Обработчик здесь (в SiteLayout) — значит работает на ВСЕХ страницах.
    document.querySelectorAll('a[href*="znms_widget_open"],[data-znms-open]').forEach(function(a){
      a.addEventListener('click',function(e){
        try{ if(window.znmsWidget&&window.znmsWidget.open&&window.znmsWidget.open(c)){e.preventDefault();} }catch(err){}
      });
    });
  });
})();`;
// @font-face объявляем здесь (а не в CSS), чтобы url() ассетов получал base-префикс.
const fontFace = `@font-face{font-family:"Monotype Corsiva";src:url(${JSON.stringify(withBase('/fonts/monotype-corsiva.woff2'))}) format("woff2"),url(${JSON.stringify(withBase('/fonts/monotype-corsiva.woff'))}) format("woff");font-weight:400 700;font-style:normal;font-display:swap;}`;
// Montserrat — наборный/UI (заказчик 2026-09-25, вместо Lora). Self-hosted (@fontsource,
// OFL 1.1), кириллица+латиница, веса 400/500/600/700. Внешний Google Fonts не подключаем:
// чужой домен блокирует первую отрисовку на медленном мобильном.
// url() через withBase (base-префикс для GitHub Pages). latin-ext несёт знак ₽ (U+20BD).
const textSubsets: Record<string, string> = {
  'cyrillic-ext':'U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F',
  'cyrillic':'U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116',
  'latin-ext':'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF',
  'latin':'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD',
};
const textFace = [400,500,600,700].map((w) =>
  Object.entries(textSubsets).map(([s, range]) =>
    `@font-face{font-family:'Montserrat';font-style:normal;font-weight:${w};font-display:optional;src:url(${JSON.stringify(withBase(`/fonts/montserrat/montserrat-${w}-${s}.woff2`))}) format('woff2');unicode-range:${range};}`
  ).join('')
).join('');
// ВРЕМЕННО, для сравнения шрифтов заказчицей: Lora (прежний наборный) подключена рядом с Montserrat.
// Грузится только когда включена (браузер не качает неиспользуемый @font-face).
// Переключатель виден лишь по ссылке ?fonts (см. скрипты ниже). Убрать вместе с public/fonts/lora после выбора.
const loraFace = [400,500,600].map((w) =>
  Object.entries(textSubsets).map(([s, range]) =>
    `@font-face{font-family:'Lora';font-style:normal;font-weight:${w};font-display:swap;src:url(${JSON.stringify(withBase(`/fonts/lora/lora-${w}-${s}.woff2`))}) format('woff2');unicode-range:${range};}`
  ).join('')
).join('');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <!-- Заголовки: Monotype Corsiva (локально). Наборный/UI: Montserrat (тоже локально, self-hosted). -->
    <style is:inline set:html={fontFace + textFace + loraFace}></style>
    <!-- Сравнение шрифтов (временно): ?fonts — показать переключатель, ?fonts=off — убрать.
         Выбор применяется до отрисовки, чтобы страница не «прыгала» шрифтом. -->
    <script is:inline>
      (function () {
        try {
          var q = location.search;
          if (/[?&]fonts=off\b/.test(q)) { localStorage.removeItem('ps-font-compare'); localStorage.removeItem('ps-font'); }
          else if (/[?&]fonts\b/.test(q)) localStorage.setItem('ps-font-compare', '1');
          if (localStorage.getItem('ps-font-compare') && localStorage.getItem('ps-font') === 'lora') document.documentElement.setAttribute('data-font', 'lora');
        } catch (e) {}
      })();
    </script>
    <link rel="preload" href={withBase('/fonts/monotype-corsiva.woff2')} as="font" type="font/woff2" crossorigin />
    <!-- Предзагрузка критичных субсетов Montserrat: над сгибом текст кириллический, двух весов —
         500 (лид hero, body) и 600 (меню, overline, кнопка «Забронировать»). Латиница над
         сгибом не встречается, её не грузим, чтобы не отнимать канал у LCP-картинки. -->
    <link rel="preload" href={withBase('/fonts/montserrat/montserrat-500-cyrillic.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase('/fonts/montserrat/montserrat-600-cyrillic.woff2')} as="font" type="font/woff2" crossorigin />
    <!-- раннее соединение с хостом виджета бронирования (ускоряет загрузку формы) -->
    <link rel="preconnect" href="https://widget.bronirui-online.ru" crossorigin />
    <link rel="dns-prefetch" href="//widget.bronirui-online.ru" />
    <!-- Страница может добавить сюда свои теги (напр. preload LCP-картинки hero). -->
    <slot name="head" />
  </head>
  <body>
    <slot />

    <!-- Cookie-баннер: показываем один раз, пока пользователь не согласится (localStorage) -->
    <div class="cookie-banner" id="cookie-banner" hidden role="dialog" aria-label="Уведомление об использовании cookie">
      <p class="cookie-banner__text">
        Мы используем файлы cookie для улучшения работы сайта. Оставаясь на сайте, вы соглашаетесь с нашей
        <a href={withBase('/files/Политика-конфиденциальности.pdf')} target="_blank" rel="noopener noreferrer">Политикой конфиденциальности</a>.
      </p>
      <button class="btn btn--gold cookie-banner__btn" id="cookie-banner-accept" type="button">Хорошо</button>
    </div>
    <script is:inline>
      (function () {
        var KEY = 'ps-cookie-consent';
        var run = function () {
          try { if (localStorage.getItem(KEY)) return; } catch (e) {}
          var el = document.getElementById('cookie-banner');
          if (!el) return;
          el.hidden = false;
          document.getElementById('cookie-banner-accept').addEventListener('click', function () {
            try { localStorage.setItem(KEY, '1'); } catch (e) {}
            el.hidden = true;
          });
        };
        if (document.readyState !== 'loading') run();
        else document.addEventListener('DOMContentLoaded', run);
      })();
    </script>
    <!-- Переключатель шрифта для заказчицы (временно, только по ссылке ?fonts) -->
    <script is:inline>
      (function () {
        var on = false;
        try { on = !!localStorage.getItem('ps-font-compare'); } catch (e) {}
        if (!on) return;
        var root = document.documentElement;
        var box = document.createElement('div');
        box.className = 'font-switch';
        box.setAttribute('role', 'group');
        box.setAttribute('aria-label', 'Шрифт сайта');
        [['montserrat', 'Montserrat'], ['lora', 'Lora']].forEach(function (f) {
          var b = document.createElement('button');
          b.type = 'button';
          b.textContent = f[1];
          b.setAttribute('data-font-pick', f[0]);
          b.className = 'font-switch__btn font-switch__btn--' + f[0];
          box.appendChild(b);
        });
        var sync = function () {
          var cur = root.getAttribute('data-font') === 'lora' ? 'lora' : 'montserrat';
          box.querySelectorAll('button').forEach(function (b) {
            b.setAttribute('aria-pressed', b.getAttribute('data-font-pick') === cur ? 'true' : 'false');
          });
        };
        box.addEventListener('click', function (e) {
          var b = e.target.closest('[data-font-pick]');
          if (!b) return;
          var f = b.getAttribute('data-font-pick');
          if (f === 'lora') root.setAttribute('data-font', 'lora'); else root.removeAttribute('data-font');
          try { localStorage.setItem('ps-font', f); } catch (err) {}
          sync();
        });
        sync();
        document.body.appendChild(box);
      })();
    </script>
    <script src={booking.scriptSrc} async is:inline></script>
    <script is:inline set:html={initJs}></script>
    <!-- Русский типограф (глобально): короткие слова 1–2 буквы клеятся к следующему
         неразрывным пробелом — предлоги/союзы не висят в конце строки. Идемпотентен. -->
    <script is:inline>
      (function () {
        var glue = function (s) {
          var out = s, prev;
          do { prev = out; out = out.replace(/(^|[\s(«"—])([А-ЯЁа-яёA-Za-z]{1,2})[ \t]+/g, '$1$2 '); }
          while (out !== prev);
          return out;
        };
        var SKIP = { SCRIPT: 1, STYLE: 1, NOSCRIPT: 1, TEXTAREA: 1, INPUT: 1 };
        var walk = function (node) {
          for (var i = 0; i < node.childNodes.length; i++) {
            var child = node.childNodes[i];
            if (child.nodeType === 3) {
              if (/[А-Яа-яЁё]/.test(child.nodeValue)) {
                var glued = glue(child.nodeValue);
                if (glued !== child.nodeValue) child.nodeValue = glued;
              }
            } else if (child.nodeType === 1 && !SKIP[child.tagName]) {
              walk(child);
            }
          }
        };
        var run = function () { walk(document.body); };
        if (document.readyState !== 'loading') run();
        else document.addEventListener('DOMContentLoaded', run);
      })();
    </script>
    <!-- Edge-fade лент-переключалок (.ow-menu): белые градиенты по краям появляются,
         только когда за краем реально есть кнопки (классы fade-l/fade-r на обёртке) -->
    <script is:inline>
      (function () {
        var init = function () {
          document.querySelectorAll('.ow-menu').forEach(function (menu) {
            var wrap = menu.parentElement;
            if (!wrap) return;
            var upd = function () {
              var over = menu.scrollWidth > menu.clientWidth + 1;
              wrap.classList.toggle('fade-l', over && menu.scrollLeft > 2);
              wrap.classList.toggle('fade-r', over && menu.scrollLeft < menu.scrollWidth - menu.clientWidth - 2);
            };
            menu.addEventListener('scroll', upd, { passive: true });
            window.addEventListener('resize', upd);
            upd();
          });
        };
        if (document.readyState !== 'loading') init();
        else document.addEventListener('DOMContentLoaded', init);
      })();
    </script>
  </body>
</html>
