---
import SiteLayout from '../layouts/SiteLayout.astro';
import LogoMark from '../components/LogoMark.astro';
import { getPage, site, withBase } from '../lib/content';
import { vkNews, vkGroupHref, newsImg } from '../lib/vk-news';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Картинки главной лежат в src/assets/images и оптимизируются Astro (webp + адаптивный srcset).
// Резолвер переводит путь из JSON ("/images/...") в импортированный ассет.
const imgAssets = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png}',
  { eager: true },
);
const img = (p?: string): ImageMetadata | undefined =>
  p ? imgAssets['/src/assets' + p.split('?')[0]]?.default : undefined;
// оптимизированный постер для <video> (webp через getImage)
const posterOf = async (p: string | undefined, width: number) => {
  const m = img(p);
  return m ? (await getImage({ src: m, width, format: 'webp' })).src : undefined;
};

const page = getPage('home');
const byId: Record<string, any> = Object.fromEntries(page.sections.map((s: any) => [s.id, s]));

const blocksOf = (s: any, type: string) => (s?.blocks ?? []).filter((b: any) => b.type === type && !b.disabled);
const blockOf = (s: any, type: string) => blocksOf(s, type)[0];

// — hero / slider —
const slider = byId['slider'];
const heroVideos = (slider?.blocks ?? []).filter((b: any) => b.type === 'video');
const heroDesktop = heroVideos.find((v: any) => v.variant === 'desktop');
const heroMobile = heroVideos.find((v: any) => v.variant === 'mobile');
const heroAutumn = heroVideos.find((v: any) => v.variant === 'autumn-desktop');
const heroWinter = heroVideos.find((v: any) => v.variant === 'winter-desktop');
const heroCover = img('/images/hero-cover.jpg'); // статичная обложка hero (вместо видео)
// LCP-картинка hero: считаем srcset заранее, чтобы отдать <link rel=preload as=image> в <head>.
// Браузер начинает качать hero сразу при парсинге HTML (не дожидаясь разбора CSS) — режет LCP.
// Параметры ОБЯЗАНЫ совпадать с <Image> ниже (widths/sizes/format/quality), иначе preload не переиспользуется.
const heroPreload = heroCover
  ? await getImage({ src: heroCover, widths: [960, 1280, 1600, 2000, 2560], sizes: '100vw', format: 'webp', quality: 87 })
  : null;
const _paperMeta = img('/images/paper.png'); // вырезанный лист бумаги (прозрачный фон) — фон плашки «Оазиса»
const paperTexUrl = _paperMeta ? (await getImage({ src: _paperMeta, width: 1120, format: 'webp' })).src : undefined;
const heroDesktopPoster = await posterOf(heroDesktop?.poster, 1920);
const heroMobilePoster = await posterOf(heroMobile?.poster, 1080);
const heroAutumnPoster = await posterOf(heroAutumn?.poster, 1920);
const heroWinterPoster = await posterOf(heroWinter?.poster, 1920);

const heroEyebrow = blockOf(slider, 'subtitle')?.text; // "Отдых для двоих среди леса"
const heroTitle = blockOf(slider, 'heading')?.text; // "Парк Север"
const _htWords = (heroTitle ?? '').trim().split(/\s+/);
const heroTitleAccent = _htWords.length > 1 ? _htWords.pop() : ''; // последнее слово — золотой акцент («Север»)
const heroTitleMain = _htWords.join(' ');
const heroParas = (slider?.blocks ?? []).filter((b: any) => b.type === 'paragraph' && !b.disabled && b.variant !== 'accent' && !b.text.includes('Деятельность'));
const heroAccent = (slider?.blocks ?? []).find((b: any) => b.type === 'paragraph' && b.variant === 'accent')?.text; // курсивная строка hero (1.4)
const activityBadge = (slider?.blocks ?? []).find((b: any) => b.type === 'paragraph' && b.text.includes('Деятельность'))?.text;

// маршрут до парка (Яндекс.Навигатор) — используется в нескольких CTA на странице
const routeHref = 'https://yandex.ru/navi?whatshere%5Bpoint%5D=37.8149250717716%2C56.45656463673545&whatshere%5Bzoom%5D=20.476816&ll=37.8149250717716%2C56.45656463635388&z=20.476816&si=j2frx76vg7073bcw444ez8w15w';

// — oasis: контент инлайн в компоненте (правки заказчика 24.08), блок больше не читаем из JSON —
const oasisTitle = 'Оазис спокойствия среди леса';
const oasisParas = [
  'Мы создали место, которого нам самим не хватало, отвечающее высшим требованиям к качеству жизни, а скрытые чеки отсутствуют. У нас предусмотрен удалённый сервис, где дом полностью укомплектован к вашему приезду по предзаказу, включая гастрономические сеты или создание особой атмосферы.',
  'Полная приватность в стеклянном «smart» доме посреди леса, где мир сужается только до двоих.',
  'Душа пространства — воспитанные золотистые ретриверы.',
  'Главное сокровище территории — благородные европейские олени английской генетики, живущие на собственных пастбищах фермы «Благородный Север».',
];
const oasisChips = '12,4 га • Без соседей • 80 км от МКАД';
const oasisGallery = [
  '/images/home/art/art-step-5.jpg', // терраса на закате — заменили фото с растениями (правка 24.08)
  '/images/home/oasis/1.2.jpg',
  '/images/home/oasis/1.3.jpg',
];

// — «Что входит в ваш отдых» (новый блок, правка 24.08; контент — инлайн) —
const includedTitle = 'Что входит в ваш отдых';
const includedItems = [
  { title: 'Инженерия комфорта', text: 'Интегрированный «Умный дом», бесшовные тёплые полы и продуманное освещение для любого сценария отдыха.' },
  { title: 'SPA-ритуал восстановления', text: 'Магниевая и морская соль, натуральные масла, индивидуальные косметические принадлежности и мягкие халаты.' },
  { title: 'Завтрак уже ждёт вас', text: 'Набор продуктов для завтрака в холодильнике к вашему приезду.' },
  { title: 'Всё для огня', text: 'Полностью оборудованная зона барбекю с дровами, углями и розжигом.' },
  { title: 'Отдых без доплат', text: 'Велосипеды, бадминтон, коврики для йоги, настольные игры, книги и творческий чемоданчик.' },
  { title: 'Познакомиться с оленеводством', text: 'Наблюдение за оленями на пастбищах и возможность индивидуальной экскурсии по закрытой ферме.' },
  { title: 'Четвероногие терапевты', text: 'Наши золотистые ретриверы всегда рады общению, но прекрасно понимают личные границы гостей. Если вам хочется полного уединения — мы сразу заберём их домой.' },
];
const includedExtraTitle = 'Дополнительные услуги по желанию';
const includedExtraList = [
  'Авторские гриль-сеты',
  'Домашние супы',
  'Праздничное оформление дома',
  'Услуги шеф-повара',
];

// — art-of-rest: контент инлайн в компоненте (правки заказчика 24.08), блок больше не читаем из JSON.
// Фото шагов 02–04 без изменений (те же кадры, что были); фото шага 01 — новое (пробка у выезда
// из города), заказчица прислала исходник отдельным файлом (1024×768, в докс-вложении было
// сжато Word'ом до 357×268 — не годилось). —
const artTitle = 'Искусство отдыха';
const artSubtitle = 'Путь к настоящему отдыху.';
const artSteps = [
  { step: '01', title: 'Перед тем как хочется уехать', text: 'Мозгу тоже нужны паузы.', image: '/images/home/art/art-step-1.jpg' },
  { step: '02', title: 'Как почувствовать отдых', text: 'Вначале просто переключить внимание.', image: '/images/home/art/art-step-2.jpg' },
  { step: '03', title: 'Перед тем как стать ближе', text: 'Нужно только остаться вдвоём.', image: '/images/home/art/art-step-3.jpg' },
  { step: '04', title: 'Сколько нужно отдыхать', text: 'А может перестать считать время?', image: '/images/home/art/art-step-4.jpg' },
];

// — house-forest (new) —
const houseForest = byId['house-forest'];
const houseForestTitle = blockOf(houseForest, 'heading')?.text;
const houseForestParas = blocksOf(houseForest, 'paragraph');
const houseForestBtn = blockOf(houseForest, 'button');
const houseForestGallery = blockOf(houseForest, 'gallery')?.images ?? [];
// Слайды «Дома»: горизонтальные кадры — по одному на весь экран; вертикальные (портрет)
// идут коллажем по два в ряд, иначе на всю ширину их сильно растягивает/режет.
const houseVerticals = ['/images/home/accommodation/4.5.jpg', '/images/home/accommodation/4.6.jpg'];
const houseSlides: string[][] = [];
let housePendingV: string[] = [];
for (const src of houseForestGallery) {
  if (houseVerticals.includes(src)) {
    housePendingV.push(src);
    if (housePendingV.length === 2) { houseSlides.push(housePendingV); housePendingV = []; }
  } else {
    houseSlides.push([src]);
  }
}
if (housePendingV.length) houseSlides.push(housePendingV);

// — atmosphere (new) —
const atmosphere = byId['atmosphere'];
const atmosphereTitle = blockOf(atmosphere, 'heading')?.text;
const atmosphereSubtitle = blockOf(atmosphere, 'subtitle')?.text;
const atmosphereGallery = blockOf(atmosphere, 'gallery')?.images ?? [];
const atmosphereItems = atmosphere?.items ?? [];

// — our-world (new) —
const world = byId['our-world'];
const worldTitle = blockOf(world, 'heading')?.text;
const worldItems = world?.items ?? [];
// описания карточек «Наш мир» (инлайн — заказчик правит напрямую).
// Порядок соответствует items: Собаки · Олени · Пруд · Велопрогулки · Интересные места рядом.
const worldDesc: string[] = [
  'Золотистые ретриверы парка свободно гуляют по территории и всегда рады гостям.',
  'На территории — собственная ферма благородного оленя «Благородный Север».',
  'Тихий лесной пруд — для неспешных прогулок и созерцания.',
  'Скоростные велосипеды для прогулок по лесным маршрутам парка.',
  'Рядом — Сергиев Посад и другие места, куда стоит выбраться.',
];

// — advantages («Почему стоит выбрать нас») —
const advantages = byId['advantages'];
const advantagesItems = advantages?.items ?? [];

// — истории (ВК + отзывы Яндекс); лента новостей — из общего модуля src/lib/vk-news.ts —
const storiesSec = byId['reviews'];
const hd = (s: any) => blockOf(s, 'heading')?.text;
const yandexReviewsSrc = site.integrations.yandexReviews?.iframeSrc;

const booking = site.contacts.bookingHref;
const c = site.contacts;

const socialLabels: Record<string, string> = {
  vk: 'ВКонтакте', whatsapp: 'WhatsApp', tiktok: 'TikTok',
  instagram: 'Instagram', telegram: 'Telegram', youtube: 'YouTube', rutube: 'RUTUBE',
};

const navMenu = [
  { t: 'Главная', href: '/' },
  { t: 'Дома', href: '/accommodation/house-1' },
  { t: 'Искусство отдыха', href: withBase('/art-of-rest') },
  { t: 'Атмосфера для двоих', href: withBase('/atmosphere/') },
  { t: 'Наш мир', href: withBase('/our-world/') },
  { t: 'Истории', href: withBase('/stories/') },
];
---
<SiteLayout title={page.seo.title}>
  {heroPreload && (
    <link
      slot="head"
      rel="preload"
      as="image"
      imagesrcset={heroPreload.srcSet.attribute}
      imagesizes="100vw"
      fetchpriority="high"
    />
  )}
  <!-- NAV (Sticky Navigation with Mobile Hamburger) -->
  <nav class="nav">
    <div class="wrap">
      <a class="nav__logo" href="/"><LogoMark class="nav__logo-mark" />Парк Север</a>
      
      <button class="nav__toggle" aria-label="Открыть меню">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div class="nav__menu">
        {navMenu.map((m) => <a href={m.href}>{m.t}</a>)}
      </div>

      <a class="nav__book" href={booking}>Забронировать</a>
    </div>
  </nav>

  <!-- HERO (Seasonal video background, Overlay content) -->
  <header class="hero">
    <div class="hero__media">
      {heroCover && (
        <Image class="hero__img" src={heroCover} alt="Парк Север — стеклянный дом среди леса" widths={[960, 1280, 1600, 2000, 2560]} sizes="100vw" format="webp" quality={87} loading="eager" fetchpriority="high" />
      )}
    </div>
    <div class="hero__scrim"></div>
    <div class="wrap hero__wrap">
      {heroEyebrow && <div class="hero__overline">{heroEyebrow.replace(/\s*\.\s*$/, '')}</div>}
      <div class="hero__brand">
        <LogoMark class="hero__mark" />
        <h1 class="hero-title" style="color:#fff; margin:0;">{heroTitleMain}{heroTitleAccent && <> <span class="hl">{heroTitleAccent}</span></>}</h1>
      </div>

      {heroAccent && <p class="hero-accent" style="margin:16px 0 28px;">{heroAccent}</p>}

      <div class="hero__lead-text" style="margin-bottom:28px; max-width:556px;">
        <p class="body-lead hero__lead">{heroParas.map((p: any) => p.text).join(' ')}</p>
      </div>

      <!-- 1.5 Модуль бронирования znms (инлайновая форма заезд/выезд/гости).
           Скелетон показывается сразу и снимается, когда виджет отрисует свою форму. -->
      <div id="znms-widget-1" class="hero__booking">
        <div class="znms-skeleton" aria-hidden="true">
          <span class="znms-skeleton__title"></span>
          <div class="znms-skeleton__row">
            <span class="znms-skeleton__field"></span>
            <span class="znms-skeleton__field"></span>
          </div>
          <span class="znms-skeleton__field znms-skeleton__field--wide"></span>
          <span class="znms-skeleton__btn"></span>
        </div>
      </div>
    </div>
    {activityBadge && (
      <div style="position: absolute; bottom: 24px; left: 32px; font-size: 13px; font-family: var(--font-head); font-weight: 500; color: #fff; z-index: 2;">
        {activityBadge}
      </div>
    )}
  </header>

  <!-- Блок 2: Оазис спокойствия среди леса (тёмная сцена с зерном бумаги + карусель «фотокарточек») -->
  <section class="sec sec--gold" id="oasis" style={paperTexUrl ? `--paper-tex:url(${paperTexUrl})` : undefined}>
    <div class="wrap wrap--flush oasis-layout">
      <div class="oasis-paper">
        <h2 class="h2" style="margin-bottom:24px;">{oasisTitle}</h2>
        {oasisParas.map((t: string) => (
          <p class="body" style="font-size:18px; line-height:1.5; font-weight:500; margin-bottom:14px;">{t}</p>
        ))}
        <p class="oasis-chips">{oasisChips}</p>
        <a class="btn btn--navy" style="margin-top:18px;" href={routeHref} target="_blank" rel="noopener noreferrer">Проложить маршрут</a>
      </div>

      <div class="oasis-carousel oasis-carousel--wide" data-carousel>
        <div class="oasis-carousel__track">
          {oasisGallery.map((src: string) => (
            <figure class="oasis-card oasis-card--paper">
              <Image src={img(src)!} alt="Оазис спокойствия среди леса" widths={[400, 640, 960]} sizes="(max-width:900px) 80vw, 420px" format="webp" quality={87} loading="lazy" draggable={false} />
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Блок 2.5: Что входит в ваш отдых (тёмно-синяя сцена, золотой заголовок, колонки текста без плашек) -->
  <section class="sec sec--navy" id="whats-included">
    <div class="wrap wrap--flush">
      <div class="shead">
        <h2 class="h2">{includedTitle}</h2>
      </div>
      <div class="included-items">
        {includedItems.map((it: any) => (
          <div class="included-item">
            <span class="included-item__rule"></span>
            <p class="included-item__t">{it.title}</p>
            <p class="included-item__x">{it.text}</p>
          </div>
        ))}
      </div>

      <div class="included-extra">
        <h3 class="aor-h3">{includedExtraTitle}</h3>
        <p class="aor-strong" style="margin-top:0;">Гастрономический сервис (единственная категория услуг, которая оплачивается отдельно)</p>
        <p class="aor-p">Для тех случаев, когда хочется полностью забыть о бытовых вопросах:</p>
        <ul class="aor-list included-extra__list">
          {includedExtraList.map((li: string) => <li>{li}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Блок 3: Искусство отдыха (Шаги-таймлайн) -->
  <section class="sec sec--art" id="art-of-rest">
    <div class="wrap wrap--flush">
      <div class="shead">
        <h2 class="h2">{artTitle}</h2>
        <p class="lead">{artSubtitle}</p>
      </div>
      <div class="art-steps">
        {artSteps.map((step: any) => (
          <div class="art-step">
            <div class="art-step__img">
              <Image src={img(step.image)!} alt={step.title} widths={[400, 640, 800]} sizes="(max-width:860px) 50vw, 25vw" format="webp" quality={87} loading="lazy" />
              <div class="art-step__overlay">
                <span class="art-step__num">{step.step}</span>
                <h3 class="art-step__title">{step.title}</h3>
                <p class="art-step__text">{step.text}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="art-cta">
        <a class="btn btn--navy" href={withBase('/art-of-rest')}>Узнать как работает отдых</a>
      </div>
    </div>
  </section>

  <!-- Блок 4: Дом среди леса — полноэкранный фото-слайдер, текст поверх фото на коричневом градиенте -->
  {houseForest && !houseForest.disabled && (
    <section class="house" id="house-forest">
      <div class="slider-container house__slider">
        <div class="slider-snap">
          {houseSlides.map((group: string[]) => (
            <div class:list={["slider-snap__slide", { "slider-snap__slide--pair": group.length === 2 }]}>
              {group.map((src: string) => (
                <Image src={img(src)!} alt="Дом среди леса" widths={[640, 960, 1280, 1600, 2000]} sizes={group.length === 2 ? "50vw" : "100vw"} format="webp" quality={87} loading="lazy" />
              ))}
            </div>
          ))}
        </div>
        <div class="house__scrim"></div>
        <div class="wrap wrap--flush house__content">
          <div class="house__text">
            <h2 class="h2 house__title">{houseForestTitle}</h2>
            {houseForestParas.map((p: any) => (
              <p class="lead house__lead">{p.text}</p>
            ))}
            {houseForestBtn && (
              <a class="btn btn--outline-light" href={houseForestBtn.href}>{houseForestBtn.text}</a>
            )}
          </div>
        </div>
        <div class="slider-arrows house__arrows">
          <button class="slider-arrow slider-arrow--left" aria-label="Назад">&larr;</button>
          <button class="slider-arrow slider-arrow--right" aria-label="Вперед">&rarr;</button>
        </div>
        <div class="slider-dots house__dots">
          {houseSlides.map((_, idx) => (
            <button class={`slider-dot ${idx === 0 ? 'active' : ''}`} data-index={idx} aria-label={`Слайд ${idx + 1}`}></button>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Блок 5: Атмосфера для двоих -->
  {atmosphere && !atmosphere.disabled && (
    <section class="sec sec--navy" id="atmosphere">
      <div class="wrap">
        <div class="shead" style="margin-bottom:48px;">
          <h2 class="h2">{atmosphereTitle}</h2>
          {atmosphereSubtitle && <p class="lead" style="color:#fff; text-align:center;">{atmosphereSubtitle}</p>}
        </div>
      </div>

      <!-- иконки-поводы — бегущая лента-полоса (как на вкладке «Атмосфера»), без анимации на месте -->
      <div class="wrap wrap--flush">
        <div class="atm-marquee atm-marquee--icons" aria-label="Поводы для атмосферы">
          <div class="atm-marquee__track">
            {[0, 1, 2, 3, 4, 5].map((copy: number) => (
              <div class="atm-marquee__group" aria-hidden={copy > 0 ? 'true' : undefined}>
                {atmosphereItems.map((item: any) => (
            <div class="atmosphere-icon">
              <div class="atmosphere-icon__svg">
                {item.icon === 'heart' && (
                  <svg viewBox="0 0 256 256" width="100%" height="100%" fill="currentColor">
                    <path d="M240,102c0,70-103.79,126.66-108.21,129a8,8,0,0,1-7.58,0C119.79,228.66,16,172,16,102A62.07,62.07,0,0,1,78,40c20.65,0,38.73,8.88,50,23.89C139.27,48.88,157.35,40,178,40A62.07,62.07,0,0,1,240,102Z"/>
                  </svg>
                )}
                {item.icon === 'cake' && (
                  <svg viewBox="0 0 256 256" width="100%" height="100%" fill="currentColor">
