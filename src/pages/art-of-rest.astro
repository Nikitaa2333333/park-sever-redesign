  <!-- КЛИЕНТСКИЕ СКРИПТЫ -->
  <script is:inline>
    // мобильное меню
    const toggle = document.querySelector('.nav__toggle');
    const menu = document.querySelector('.nav__menu');
    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        toggle.classList.toggle('active');
        menu.classList.toggle('open');
      });
      menu.querySelectorAll('a').forEach(l => l.addEventListener('click', () => {
        toggle.classList.remove('active');
        menu.classList.remove('open');
      }));
    }

    // разделы-«странички»: меню переключает панели (как в «Наш мир»), hash в URL
    (function () {
      // браузер не восстанавливает прошлую прокрутку («кидает в подвал») — управляем сами
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      const tabs = Array.from(document.querySelectorAll('[data-aor-tab]'));
      const panels = Array.from(document.querySelectorAll('[data-aor-panel]'));
      if (!tabs.length) return;
      const show = (id, scroll) => {
        const panel = panels.find(p => p.dataset.aorPanel === id);
        if (!panel) return;
        panels.forEach(p => { p.hidden = p !== panel; });
        tabs.forEach(t => t.classList.toggle('is-active', t.dataset.aorTab === id));
        if (scroll) {
          // не в обложку, а к линии контента: меню-бар прилипает под шапкой (top:56px),
          // контент — сразу под ним; offsetTop панели стабилен (sticky не выпадает из потока)
          const bar = document.getElementById('aor-menubar');
          window.scrollTo(0, Math.max(0, panel.offsetTop - (bar ? bar.offsetHeight : 0) - 56));
        }
      };
      tabs.forEach(t => t.addEventListener('click', (e) => {
        e.preventDefault();
        history.replaceState(null, '', '#' + t.dataset.aorTab);
        show(t.dataset.aorTab, true);
      }));
      // вкладку можно задать и квери-параметром ?tab=stage-1 (хэш бывает занят служебными параметрами)
      const initial = new URLSearchParams(location.search).get('tab') || location.hash.replace('#', '');
      if (initial) { show(initial, false); window.scrollTo(0, 0); }
    })();

    // русский типограф — короткие слова не висят в конце строки
    (function () {
      const glue = (s) => {
        let out = s, prev;
        do { prev = out; out = out.replace(/(^|[\s(«"—])([А-ЯЁа-яёA-Za-z]{1,2})[ \t]+/g, '$1$2 '); }
        while (out !== prev);
        return out;
      };
      const SKIP = new Set(['SCRIPT', 'STYLE', 'NOSCRIPT', 'TEXTAREA', 'INPUT']);
      const walk = (node) => {
        for (const child of Array.from(node.childNodes)) {
          if (child.nodeType === 3) {
            if (/[А-Яа-яЁё]/.test(child.nodeValue)) {
              const glued = glue(child.nodeValue);
              if (glued !== child.nodeValue) child.nodeValue = glued;
            }
          } else if (child.nodeType === 1 && !SKIP.has(child.tagName)) {
            walk(child);
          }
        }
      };
      walk(document.body);
    })();
  </script>
