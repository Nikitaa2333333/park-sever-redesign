---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LogoMark from '../../components/LogoMark.astro';
import { site, withBase } from '../../lib/content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// «Дополнительные услуги» — отдельная страница-каталог (правка заказчицы 25.08).
// Контент инлайн (не JSON) — заказчица прямо сказала, что будет часто менять.
// Фото есть пока только для «Сервировки» (вытащены из pptx заказчицы) — карточки
// остальных категорий временно с плейсхолдером-номером; когда пришлют фото,
// добавить `photo:` в объект категории — рендер уже это умеет.
const imgAssets = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/services/*.{jpg,jpeg,png}',
  { eager: true },
);
const img = (name: string) => imgAssets[`/src/assets/images/services/${name}`]?.default;
const c = site.contacts;
const booking = site.contacts.bookingHref;

const socialLabels: Record<string, string> = {
  vk: 'ВКонтакте', whatsapp: 'WhatsApp', tiktok: 'TikTok',
  instagram: 'Instagram', telegram: 'Telegram', youtube: 'YouTube', rutube: 'RUTUBE',
};

const navMenu = [
  { t: 'Главная', href: withBase('/') },
  { t: 'Дома', href: withBase('/accommodation/house-1') },
  { t: 'Искусство отдыха', href: withBase('/art-of-rest') },
  { t: 'Атмосфера для двоих', href: withBase('/atmosphere/') },
  { t: 'Наш мир', href: withBase('/our-world/') },
  { t: 'Истории', href: withBase('/stories/') },
];

// — данные по категориям, для которых заказчица прислала полную информацию —
const balloons = [
  { name: 'Шары «Сердце», 15 шт', price: '5 600 ₽' },
  { name: 'Шары 15 шт, золото', price: '3 400 ₽' },
  { name: 'Шары 15 шт, красные пастель', price: '2 900 ₽' },
];
const cakeWeights = [
  { weight: '400 г', price: '3 000 ₽' },
  { weight: '800 г', price: '4 000 ₽' },
];
const cakeFlavors = ['Ваниль с клубникой', 'Шоколадный с вишней', 'Персик-ваниль'];
// состав + фото — из второго pptx заказчицы (25.08, «Сервировка»). По её просьбе
// не пишем «подходит для» (это было в файле для каждого набора) — только состав.
// «Мужская шалость» в исходном списке заказчицы (из голосового) не упоминалась,
// но есть в файле с полным составом и ценой — добавили как есть.
const servings = [
  {
    name: 'Бордовая роза', price: '1 800 ₽', photo: 'serving-1-rose.jpg',
    items: [
      'Сервировка стола (бокалы, тарелки, столовые приборы согласно фото)',
      'Оформление из салфеток «Роза на сердце» на тарелках',
      'Оформление бордовыми лентами и бантами, открытками согласно фото',
      'Свечи (4 высокие тонкие, 2 чайные, 1 красная на подставке)',
      'Блюдо с конфетами (рафаэлло)',
      'Подушка «красное сердце» на кровати в спальне',
      'Надувная фигура «Love» в спальне',
    ],
  },
  {
    name: 'Фруктовая нежность', price: '4 100 ₽', photo: 'serving-2-fruit.jpg',
    items: [
      'Сервировка стола (бокалы, тарелки, столовые приборы согласно фото)',
      'Оформление из салфеток «платье с бантом» на тарелках',
      'Свечи (4 высокие тонкие, 2 чайные)',
      'На прикроватных полках — два рожка из тканевых салфеток с минибукетами из сухих цветов и с конфетами (рафаэлло)',
      'Фрукты и ягоды на тарелках (клубника, черешня, мандарины, яблоки, нектарины, бананы, виноград чёрный и зелёный) — список уточняется по сезону и наличию',
    ],
  },
  {
    name: 'Свидание на Руси', price: '2 800 ₽', photo: 'serving-3-rus.jpg',
    items: [
      'Сервировка стола (бокалы, тарелки, столовые приборы и салфетки согласно фото)',
      'Птицы из салфеток на столе и два платка на стульях',
      'Свечи (4 высокие тонкие, 2 чайные)',
      'В креманках: сметана и варенье (вкус варенья уточняется по факту)',
      'Блюдо с блинчиками (без начинки)',
      'Два конвертика с блинчиками на тарелках (начинка уточняется по согласованию)',
    ],
  },
  {
    name: 'Мужская шалость: карты, сигареты и сливки', price: '3 000 ₽', photo: 'serving-4-mens.jpg',
    items: [
      'Сервировка стола (бокалы, тарелки, столовые приборы согласно фото)',
      'Оформление из салфеток «пиджак для него и для неё» на тарелках',
      'Креманки со взбитыми сливками и с клубникой',
      'Тарелка со съедобными сигаретами',
      'Свечи (4 высокие тонкие, 2 чайные)',
      'Карты игральные «Советский pin up»',
    ],
  },
  {
    name: 'Особенный день для нас', price: '7 500 ₽', photo: 'serving-5-special.jpg',
    items: [
      'Сервировка стола (бокалы, тарелки, столовые приборы согласно фото)',
      'Свечи (4 высокие тонкие, 2 чайные)',
      'Брускеты, два вида: с моцареллой, черри и джемом слива-базилик; запечённый бри с джемом из инжира',
      'Салат — сочный томат с рукколой и сыром «Страчателла»',
      'Фруктовая тарелка: гранат, зелёный виноград, мандарин, яблоко, банан',
      'На десерт — малиновое пирожное «Сердце»',
    ],
  },
  {
    name: 'Гастрономический сет «У панорамного окна»', price: '5 100 ₽', photo: 'serving-6-window.jpg',
    items: [
      'Сервировка стола (бокалы, тарелки, столовые приборы)',
      'Свечи (2 высокие, 2 чайные)',
      'Сырно-мясная тарелка: сыры (с белой плесенью, с голубой плесенью, маасдам, моцарелла), мясное ассорти (шейка, балык, бекон), сырокопчёные колбасы (брауншвейгская, велкомовская, миланская)',
      'Овощная тарелка: салат листовой, зелень (лук, укроп, петрушка), помидоры черри, огурцы, редис, сладкий перец',
      'Хлебная тарелка: багет ржаной чесночный, чиабатта, булочки пшеничные, хлеб бородинский',
    ],
  },
];
// отдельные блюда «в розницу» — из тех же слайдов файла (можно заказать без набора)
const alacarte = [
  { name: 'Фруктовая тарелка', desc: 'Мандарины, яблоки, бананы, виноград чёрный и зелёный и т.д. Список уточняется по сезону и наличию.', price: '1 700 ₽' },
  { name: 'Блины', desc: '14–16 шт, часть подпечённые, со сметаной и вареньем/сгущёнкой на выбор.', price: '1 200 ₽' },
  { name: 'Брускеты, два вида', desc: 'С моцареллой, черри и джемом слива-базилик; запечённый бри с джемом из инжира.', price: '1 600 ₽' },
  { name: 'Салат', desc: 'Сочный томат с рукколой и сыром «Страчателла» (за 2 шт).', price: '1 200 ₽' },
  { name: 'Сырно-мясная тарелка', desc: 'Сыры (с белой плесенью, с голубой плесенью, маасдам, моцарелла), мясное ассорти (шейка, балык, бекон), сырокопчёные колбасы.', price: '1 900 ₽' },
  { name: 'Овощная тарелка', desc: 'Салат листовой, ассорти зелени (лук, укроп, петрушка), помидоры черри, огурцы, редис, сладкий перец.', price: '1 200 ₽' },
  { name: 'Сырная тарелка', desc: 'Сыры (с белой плесенью, с голубой плесенью, маасдам, моцарелла), мёд, грецкие орехи, виноград.', price: '1 900 ₽' },
  { name: 'Мясная тарелка', desc: 'Мясное ассорти (шейка, балык, бекон), сырокопчёные колбасы, бекон с/к, маслины.', price: '1 200 ₽' },
  { name: 'Орехи ассорти', desc: 'Миндаль, кешью, фундук, арахис — жареные, фисташки.', price: '1 300 ₽' },
  { name: 'Хлебная тарелка', desc: 'Багет ржаной чесночный, чиабатта, булочка пшеничная (2 шт), хлеб бородинский.', price: '500 ₽' },
];

// — гриль-меню, супы, шеф-повар: из pptx заказчицы (25.08) —
const grillSets = [
  {
    emoji: '🥩', title: 'Северный гриль', price: '7 500 ₽',
    desc: 'Классика отдыха за городом.',
    items: [
      'Замаринованное мясо: свиная шейка, куриные шашлычки на шпажках',
      'Свежие овощи на стол: красный лук, помидоры, огурцы, зелень',
      'Овощи для гриля: красный перец, кабачок, помидоры, грибы',
      'Лаваш — 2 шт',
      'Соусы: BBQ, брусничный',
    ],
  },
  {
    emoji: '🔥', title: 'Вечер у костра', price: '5 000 ₽',
    desc: 'Для неспешного вечера на свежем воздухе.',
    items: [
      'Мясо: колбаски для гриля, куриные крылья (замаринованные)',
      'Картофель для запекания (предварительно отваренный)',
      'Свежие овощи: помидоры, огурцы, красный лук, зелень',
      'Багет — 1 шт',
      'Соусы: медово-горчичный, горчица',
      'Маршмеллоу для костра',
    ],
  },
  {
    emoji: '🐑', title: 'Огонь и дым', price: '6 000 ₽',
    desc: 'Для тех, кто любит насыщенный вкус и аромат настоящего огня.',
    items: [
      'Люля-кебаб из баранины — 5 шт',
      'Бифштекс из говядины — 6 шт',
      'Свежие овощи: помидоры, огурцы, красный лук, зелень',
      'Лепёшка — 1 шт',
      'Соусы: острая аджика, соус 4 перца',
    ],
  },
  {
    emoji: '🐟', title: 'Вечер на террасе', price: '8 500 ₽',
    desc: 'Лёгкий ужин с видом на лес — рыба на гриле, овощи и неспешный вечер на террасе среди тишины и природы.',
    items: [
      'На выбор: стейки форели (4 шт) или дорадо (2 шт)',
      'Картофель для запекания в фольге',
      'Овощи для гриля: красный перец, кабачок, помидоры',
      'Багет — 1 шт',
      'Соус тар-тар',
    ],
  },
];
// в присланном pptx у «Борща» и «Куриного бульона» было скопировано описание
// горохового супа («суп с копчёностями») — явная опечатка заказчицы, здесь не
// повторяем неверный текст, оставили общее для всех троих (готовится заранее,
// объём, хранение) — состав уточнить у заказчицы
const soups = [
  { title: 'Суп гороховый', price: '3 500 ₽', desc: 'Гороховый суп с копчёностями. Готовится заранее и ждёт в холодильнике к приезду, в кастрюле. Объём 2–2,5 л.' },
  { title: 'Борщ', price: '3 500 ₽', desc: 'Готовится заранее и ждёт в холодильнике к приезду, в кастрюле. Объём 2–2,5 л.' },
  { title: 'Куриный бульон', price: '2 500 ₽', desc: 'Готовится заранее и ждёт в холодильнике к приезду, в кастрюле. Объём 2–2,5 л.' },
];
// в pptx цена услуги указана дважды по-разному (3 500 ₽ и 3 000 ₽/вечер) — до
// уточнения у заказчицы цену на сайте не показываем, только описание
const chefDesc = 'Шеф-повар готовит и подаёт блюда на мангале в течение вечера — продукты по выбранному гриль-меню уже будут ждать вас к заселению.';

// навигация по разделам — верхняя вкладочная менюшка, как «Этап 1,2,3» на /art-of-rest
// (заказчица 29.08: убрать модальные окошки, категория открывается сразу по клику
// на вкладку, без промежуточного клика по карточке)
const tabs = [
  { id: 'grill', num: '01', title: 'Гриль-меню' },
  { id: 'soups', num: '02', title: 'Супы' },
  { id: 'chef', num: '03', title: 'Шеф-повар для мангала' },
  { id: 'balloons', num: '04', title: 'Оформление шарами' },
  { id: 'cake', num: '05', title: 'Торт' },
  { id: 'serving', num: '06', title: 'Сервировка' },
  { id: 'custom', num: '07', title: 'Индивидуальное оформление' },
];
---
<SiteLayout title="Дополнительные услуги — Парк Север">
  <!-- NAV -->
  <nav class="nav">
    <div class="wrap">
      <a class="nav__logo" href={withBase('/')}><LogoMark class="nav__logo-mark" />Парк Север</a>
      <button class="nav__toggle" aria-label="Открыть меню">
        <span></span><span></span><span></span>
      </button>
      <div class="nav__menu">
        {navMenu.map((m) => <a href={m.href}>{m.t}</a>)}
      </div>
      <a class="nav__book" href={booking}>Забронировать</a>
    </div>
  </nav>

  <section class="sec" id="services">
    <div class="wrap wrap--flush">
      <div class="shead" style="margin-bottom:8px;">
        <h1 class="h1">Дополнительные услуги</h1>
        <p class="lead" style="text-align:center;">Гастрономический сервис — единственная категория услуг, которая оплачивается отдельно. Для тех случаев, когда хочется полностью забыть о бытовых вопросах.</p>
      </div>
    </div>
  </section>

  <!-- Верхняя вкладочная навигация по категориям — как «Этап 1,2,3» на /art-of-rest.
       Клик по вкладке сразу показывает раздел, без промежуточного клика по карточке/модала. -->
  <div class="ow-menubar" id="svc-menubar">
    <div class="wrap wrap--flush">
      <nav class="ow-menu" aria-label="Категории услуг">
        {tabs.map((t, i) => (
          <a href={'#' + t.id} data-svc-tab={t.id} class={i === 0 ? 'is-active' : undefined}>{t.num}. {t.title}</a>
        ))}
      </nav>
    </div>
  </div>

  <!-- 01 ГРИЛЬ-МЕНЮ -->
  <div data-svc-panel="grill">
  <section class="sec" id="grill">
    <div class="wrap wrap--flush">
      <h2 class="h2">Гриль-меню</h2>
      <div class="aor-duo">
        {grillSets.map((s) => (
          <div>
            <h3 class="aor-h3" style="margin-top:0;">{s.emoji} {s.title} — {s.price}</h3>
            <p class="aor-p">{s.desc}</p>
            <ul class="aor-list">
              {s.items.map((it: string) => <li>{it}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
  </div>

  <!-- 02 СУПЫ -->
  <div data-svc-panel="soups" hidden>
  <section class="sec sec--cream" id="soups">
    <div class="wrap wrap--flush">
      <h2 class="h2">Супы</h2>
      <div class="aor-split">
        <div>
          {soups.map((s) => (
            <>
              <h3 class="aor-h3">{s.title} — {s.price}</h3>
              <p class="aor-p">{s.desc}</p>
            </>
          ))}
        </div>
        <div class="aor-split__pic">
          <Image src={img('soup-1.jpg')!} alt="Суп" widths={[520, 800, 1100]} sizes="(max-width:860px) 100vw, 44vw" format="webp" quality={87} loading="lazy" />
        </div>
      </div>
    </div>
  </section>
  </div>

  <!-- 03 ШЕФ-ПОВАР ДЛЯ МАНГАЛА -->
  <div data-svc-panel="chef" hidden>
  <section class="sec" id="chef">
    <div class="wrap wrap--flush">
      <h2 class="h2">Шеф-повар для мангала</h2>
      <p class="aor-p" style="margin-top:24px;">{chefDesc}</p>
      <p class="aor-p">Стоимость уточняется.</p>
    </div>
  </section>
  </div>

  <!-- 04 ОФОРМЛЕНИЕ ШАРАМИ -->
  <div data-svc-panel="balloons" hidden>
  <section class="sec sec--cream" id="balloons">
    <div class="wrap wrap--flush">
      <h2 class="h2">Оформление шарами</h2>
      <ul class="aor-list" style="margin-top:24px;">
        {balloons.map((b) => <li><b>{b.name}</b> — {b.price}</li>)}
      </ul>
    </div>
  </section>
  </div>

  <!-- 05 ТОРТ -->
  <div data-svc-panel="cake" hidden>
  <section class="sec" id="cake">
    <div class="wrap wrap--flush">
      <h2 class="h2">Торт</h2>
      <h3 class="aor-h3">Бенто-торт</h3>
      <ul class="aor-list">
        {cakeWeights.map((w) => <li>Вес {w.weight} — {w.price}</li>)}
      </ul>
      <h3 class="aor-h3">3 вкуса на выбор</h3>
      <ul class="aor-list">
        {cakeFlavors.map((f) => <li>{f}</li>)}
      </ul>
    </div>
  </section>
  </div>

  <!-- 06 СЕРВИРОВКА -->
  <div data-svc-panel="serving" hidden>
  <section class="sec sec--cream" id="serving">
    <div class="wrap wrap--flush">
      <h2 class="h2">Сервировка</h2>
      {servings.map((s: any) => (
        <div class="aor-split">
          <div>
            <h3 class="aor-h3">{s.name} — {s.price}</h3>
            <ul class="aor-list">
              {s.items.map((it: string) => <li>{it}</li>)}
            </ul>
          </div>
          <div class="aor-split__pic">
            <Image src={img(s.photo)!} alt={s.name} widths={[520, 800, 1100]} sizes="(max-width:860px) 100vw, 44vw" format="webp" quality={87} loading="lazy" />
          </div>
        </div>
      ))}
      <h3 class="aor-h3" style="margin-top:56px;">Меню по блюдам — можно заказать отдельно</h3>
      <ul class="aor-list">
        {alacarte.map((d) => <li><b>{d.name}</b> — {d.price}. {d.desc}</li>)}
      </ul>
    </div>
  </section>
  </div>

  <!-- 07 ИНДИВИДУАЛЬНОЕ ОФОРМЛЕНИЕ -->
  <div data-svc-panel="custom" hidden>
  <section class="sec" id="custom">
    <div class="wrap wrap--flush">
      <h2 class="h2">Индивидуальное оформление</h2>
      <p class="aor-p" style="margin-top:24px;">Условия уточняются — добавим подробности в ближайшее время.</p>
    </div>
  </section>
  </div>

  <!-- FOOTER -->
  <footer class="foot">
    <div class="wrap wrap--flush">
      <div class="foot__cols">
        <div>
          <div class="foot__brand">Парк Север</div>
          <p class="foot__about">Пространство на краю леса для тех, кто выбирает тишину. Приватный дом без потока людей и лишнего, на территории 12,4 га. Без соседей. Только природа, животные и ощущение, что никуда не нужно спешить.</p>
          <div class="socials">
            {site.socials.map((s: any) => <a href={s.href} target="_blank" rel="noopener noreferrer">{socialLabels[s.type] ?? s.type}</a>)}
          </div>
        </div>
        <div class="foot__col">
          <h4>Разделы</h4>
          {navMenu.map((m) => <a href={m.href}>{m.t}</a>)}
        </div>
        <div class="foot__col">
          <h4>Контакты</h4>
          <a href={c.phoneHref}>{c.phone}</a>
          <a href={c.emailHref}>{c.email}</a>
          <a href={c.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <span class="foot__addr">{c.address}</span>
        </div>
        <div class="foot__col">
          <h4>Документы</h4>
          <a href={withBase('/legal-information')}>Правовая информация</a>
          <a href={withBase('/files/Договор-оферта.pdf')} target="_blank" rel="noopener noreferrer">Договор-оферта (PDF)</a>
          <a href={withBase('/files/Правила-проживания.pdf')} target="_blank" rel="noopener noreferrer">Правила проживания (PDF)</a>
          <a href={withBase('/files/Политика-конфиденциальности.pdf')} target="_blank" rel="noopener noreferrer">Политика конфиденциальности (PDF)</a>
        </div>
      </div>
      <hr class="foot__rule" />
      <div class="foot__cp">© {site.company} · {site.requisites.entity} · {site.requisites.note}</div>
    </div>
  </footer>

  <style>
    #services{ padding-top:calc(56px + 48px); }
    #svc-menubar .ow-menu{ justify-content:safe center; }
    #svc-menubar .ow-menu a{ padding:13px 20px; }
  </style>

  <script is:inline>
    // мобильное меню
    const toggle = document.querySelector('.nav__toggle');
    const menu = document.querySelector('.nav__menu');
    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        toggle.classList.toggle('active');
        menu.classList.toggle('open');
      });
      menu.querySelectorAll('a').forEach(l => l.addEventListener('click', () => {
        toggle.classList.remove('active');
        menu.classList.remove('open');
      }));
    }

    // Вкладки категорий — та же механика «странички», что у /art-of-rest:
    // клик по вкладке переключает панель, hash в URL, без модалов.
    (function () {
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      const tabs = Array.from(document.querySelectorAll('[data-svc-tab]'));
      const panels = Array.from(document.querySelectorAll('[data-svc-panel]'));
      if (!tabs.length) return;
      const show = (id, scroll) => {
        const panel = panels.find(p => p.dataset.svcPanel === id);
        if (!panel) return;
        panels.forEach(p => { p.hidden = p !== panel; });
        tabs.forEach(t => t.classList.toggle('is-active', t.dataset.svcTab === id));
        if (scroll) {
          const bar = document.getElementById('svc-menubar');
          window.scrollTo(0, Math.max(0, panel.offsetTop - (bar ? bar.offsetHeight : 0) - 56));
        }
      };
      tabs.forEach(t => t.addEventListener('click', (e) => {
        e.preventDefault();
        history.replaceState(null, '', '#' + t.dataset.svcTab);
        show(t.dataset.svcTab, true);
      }));
      const initial = new URLSearchParams(location.search).get('tab') || location.hash.replace('#', '');
      if (initial) { show(initial, false); window.scrollTo(0, 0); }
    })();
  </script>
</SiteLayout>
