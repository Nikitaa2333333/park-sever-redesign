  <!-- КЛИЕНТСКИЕ СКРИПТЫ -->
  <script is:inline>
    // 1. Мобильное меню
    const toggle = document.querySelector('.nav__toggle');
    const menu = document.querySelector('.nav__menu');
    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        toggle.classList.toggle('active');
        menu.classList.toggle('open');
      });
      menu.querySelectorAll('a').forEach(l => l.addEventListener('click', () => {
        toggle.classList.remove('active');
        menu.classList.remove('open');
      }));
    }

    // 2. Разделы-«страницы»: горизонтальное меню переключает панели (hash в URL)
    (function () {
      // браузер не восстанавливает прошлую прокрутку («кидает в подвал») — управляем сами
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      const tabs = Array.from(document.querySelectorAll('[data-ow-tab]'));
      const panels = Array.from(document.querySelectorAll('[data-ow-panel]'));
      if (!tabs.length) return;
      const show = (id, scroll) => {
        const panel = panels.find(p => p.dataset.owPanel === id);
        if (!panel) return;
        panels.forEach(p => { p.hidden = p !== panel; });
        tabs.forEach(t => t.classList.toggle('is-active', t.dataset.owTab === id));
        if (scroll) {
          // не в обложку, а к линии контента: меню-бар прилипает под шапкой (top:56px),
          // контент — сразу под ним; offsetTop панели стабилен (sticky не выпадает из потока)
          const bar = document.getElementById('ow-menubar');
          window.scrollTo(0, Math.max(0, panel.offsetTop - (bar ? bar.offsetHeight : 0) - 56));
        }
      };
      tabs.forEach(t => t.addEventListener('click', (e) => {
        e.preventDefault();
        history.replaceState(null, '', '#' + t.dataset.owTab);
        show(t.dataset.owTab, true);
      }));
      const initial = location.hash.replace('#', '');
      if (initial) { show(initial, false); window.scrollTo(0, 0); }
    })();

    // 3. Blob-карусель: клонируем элементы ленты в начало (реверсом) — бесшовный
    //    бесконечный цикл при сдвиге на -50% (механика из пена pehaa/QYeqBO)
    (function () {
      const track = document.getElementById('ow-blob-track');
      if (!track) return;
      Array.prototype.slice.call(track.children).reverse().forEach((el) => {
        const clone = el.cloneNode(true);
        clone.classList.add('clone');
        track.insertBefore(clone, track.firstChild);
      });
    })();

    // 4. Ленты-карусели с перетаскиванием
    document.querySelectorAll('[data-carousel]').forEach(carousel => {
      const track = carousel.querySelector('.oasis-carousel__track');
      if (!track) return;
      let isDown = false, startX = 0, startScroll = 0, moved = false;
      track.addEventListener('mousedown', (e) => {
        isDown = true; moved = false; startX = e.pageX; startScroll = track.scrollLeft;
        track.classList.add('dragging');
      });
      const endDrag = () => { if (!isDown) return; isDown = false; track.classList.remove('dragging'); };
      track.addEventListener('mouseleave', endDrag);
      window.addEventListener('mouseup', endDrag);
      track.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        const walk = e.pageX - startX;
        if (Math.abs(walk) > 4) moved = true;
        track.scrollLeft = startScroll - walk;
      });
      track.addEventListener('click', (e) => { if (moved) e.preventDefault(); }, true);
    });

    // 5. Карточки собак: флип по тапу (для тач-экранов; на десктопе — hover в CSS)
    document.querySelectorAll('.ow-dog').forEach(card =>
      card.addEventListener('click', () => card.classList.toggle('is-flipped')));

    // 6. Русский типограф — короткие слова (1–2 буквы) клеим к следующему слову
    (function () {
      const glue = (s) => {
        let out = s, prev;
        do { prev = out; out = out.replace(/(^|[\s(«"—])([А-ЯЁа-яёA-Za-z]{1,2})[ \t]+/g, '$1$2 '); }
        while (out !== prev);
        return out;
      };
      const SKIP = new Set(['SCRIPT', 'STYLE', 'NOSCRIPT', 'TEXTAREA', 'INPUT']);
      const walk = (node) => {
        for (const child of Array.from(node.childNodes)) {
          if (child.nodeType === 3) {
            if (/[А-Яа-яЁё]/.test(child.nodeValue)) {
              const glued = glue(child.nodeValue);
              if (glued !== child.nodeValue) child.nodeValue = glued;
            }
          } else if (child.nodeType === 1 && !SKIP.has(child.tagName)) {
            walk(child);
          }
        }
      };
      walk(document.body);
    })();
  </script>
</SiteLayout>
