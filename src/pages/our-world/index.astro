---
import SiteLayout from '../../layouts/SiteLayout.astro';
import LogoMark from '../../components/LogoMark.astro';
import { site, pages, withBase } from '../../lib/content';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Контент вкладки «Наш мир» — дословные тексты из ТЗ (наш мир/Наш мир.docx)
// и разделов старого сайта, на которые ТЗ ссылается. Генерируется скриптом
// scripts/extract-our-world.mjs → content/pages/our-world.json. Руками не править.
const ow = pages['our-world'];

// Фото лежат в src/assets/images/our-world (ужаты scripts/optimize-our-world.mjs).
const owAssets = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/our-world/**/*.{jpg,jpeg,png}',
  { eager: true },
);
// Резолвер: имя из JSON («1.1», «dogs/Рыжуля.jpg», «services/fishing/1.jpg») → ассет.
const img = (name: string): ImageMetadata | undefined => {
  let key = name
    .replace(/^services\//, '')
    .replace('Рыжуля', 'ryzhulya')
    .replace('Гайка', 'gayka')
    .replace(/\.(jpe?g|png)$/i, '');
  return owAssets['/src/assets/images/our-world/' + key + '.jpg']?.default;
};

// ── Blob-карусель вверху (по ТЗ: «Blob Carousel For The Planet», Paulina Hetman,
// codepen.io/pehaa/pen/QYeqBO). Формы-«капли» и раскладка перенесены из пена;
// морфинг форм — нативный SVG <animate> (вместо anime.js), лента и параллакс — как в оригинале.
const BLOBS = [
  { d: 'M 109 -171.3 C 151 -142.7 201.5 -128.9 229 -96.4 C 256.4 -64 260.8 -12.9 242 26.3 C 223.2 65.6 181.1 93 149 127.8 C 116.8 162.5 94.6 204.6 61.7 217.7 C 28.7 230.9 -14.9 215.2 -54.3 197.8 C -93.7 180.4 -128.9 161.3 -151.4 132.6 C -174 104 -184 66 -196.4 24.1 C -208.8 -17.7 -223.6 -63.3 -217 -108 C -210.4 -152.8 -182.5 -196.7 -142.8 -226.4 C -103.1 -256.1 -51.5 -271.5 -9 -257.5 C 33.5 -243.5 67 -200 109 -171.3 Z', to: 'M 107.4 -157.9 C 144.8 -143 184.7 -122.8 213.5 -89 C 242.2 -55.1 259.7 -7.6 254.7 37.6 C 249.8 82.9 222.4 125.9 184.7 148.4 C 147.1 170.8 99.2 172.7 57.4 176.2 C 15.6 179.7 -20.1 184.9 -53.3 177.1 C -86.6 169.4 -117.3 148.9 -148.6 123.1 C -179.9 97.2 -211.7 66.1 -218.4 30.4 C -225.1 -5.3 -206.7 -45.7 -193.1 -93.4 C -179.4 -141.2 -170.5 -196.4 -139.2 -214 C -107.8 -231.7 -53.9 -211.8 -9.5 -197.1 C 35 -182.4 69.9 -172.8 107.4 -157.9 Z', dur: '4s' },
  { d: 'M 87.5 -116.1 C 125.2 -111.9 175.9 -107.7 182.7 -85.5 C 189.6 -63.4 152.7 -23.4 138.5 14.3 C 124.3 51.9 132.8 87.2 125.4 124.9 C 118 162.6 94.6 202.7 65.6 200.8 C 36.6 198.9 2 155.1 -31.7 133.5 C -65.4 112 -98.1 112.6 -132 99.7 C -166 86.9 -201.3 60.4 -194.4 34.8 C -187.4 9.1 -138.3 -15.8 -107.4 -34.8 C -76.5 -53.8 -64 -66.8 -49.1 -81.6 C -34.2 -96.3 -17.1 -112.6 3.9 -118.7 C 24.9 -124.7 49.7 -120.4 87.5 -116.1 Z', to: 'M 133.3 -193.4 C 174.7 -180.8 211.5 -147.1 204.2 -109.1 C 196.9 -71.1 145.5 -28.8 122.8 6.4 C 100.2 41.5 106.4 69.6 102 105.5 C 97.5 141.5 82.4 185.4 59.2 184.3 C 36 183.3 4.6 137.2 -23.2 113.4 C -51.1 89.6 -75.4 88 -92.7 76 C -110.1 63.9 -120.4 41.3 -145.1 8 C -169.9 -25.3 -209.1 -69.3 -205.3 -100.4 C -201.4 -131.4 -154.5 -149.4 -113.1 -162 C -71.7 -174.6 -35.9 -181.8 5 -189.7 C 46 -197.5 91.9 -206 133.3 -193.4 Z', dur: '4.6s' },
  { d: 'M 166.3 -136.4 C 201.2 -88.8 205.4 -20.5 190.1 42 C 174.7 104.6 139.9 161.3 88.4 187.6 C 37 213.8 -31 209.6 -92.6 183.4 C -154.3 157.1 -209.8 108.8 -224.3 49.9 C -238.8 -9.1 -212.4 -78.8 -168.2 -128.5 C -124.1 -178.3 -62 -208.1 1.8 -209.6 C 65.7 -211 131.3 -184.1 166.3 -136.4 Z', to: 'M 179.9 -148.8 C 223.3 -89.1 241.8 -14.8 227.9 54.3 C 213.9 123.4 167.5 187.4 106.5 214 C 45.6 240.6 -29.9 229.7 -95 198.1 C -160 166.4 -214.5 113.9 -230.4 50.7 C -246.4 -12.5 -223.6 -86.4 -178.8 -146.4 C -134 -206.5 -67 -252.7 0.7 -253.3 C 68.3 -253.8 136.6 -208.6 179.9 -148.8 Z', dur: '5.2s' },
  { d: 'M 167.9 -131.9 C 201.9 -91.3 202.8 -22.4 181 28.5 C 159.1 79.4 114.5 112.2 66.4 133.7 C 18.4 155.3 -33.1 165.5 -75.5 148.3 C -117.8 131.1 -151 86.6 -154.3 43.5 C -157.5 0.4 -130.7 -41.3 -100 -81.1 C -69.3 -120.9 -34.7 -159 16.2 -171.9 C 67 -184.7 134 -172.5 167.9 -131.9 Z', to: 'M 70.5 -74.2 C 95.7 -24.7 123.4 4.9 128.3 47.6 C 133.1 90.3 115.2 146 69.9 181.9 C 24.7 217.7 -47.7 233.7 -111.4 210.8 C -175 188 -229.8 126.5 -220.6 76.3 C -211.4 26.1 -138.2 -12.8 -90.7 -67.5 C -43.3 -122.2 -21.6 -192.6 0.5 -193 C 22.7 -193.4 45.3 -123.8 70.5 -74.2 Z', dur: '4.2s' },
  { d: 'M 78.3 -67.6 C 102.3 -32.3 123.3 0.3 122.6 37.9 C 121.9 75.4 99.6 117.9 70.7 122.5 C 41.8 127 6.4 93.7 -41.3 74.9 C -88.9 56.1 -148.8 51.9 -160.4 28.7 C -171.9 5.6 -135.2 -36.5 -100.4 -74.3 C -65.7 -112 -32.8 -145.5 -2.9 -143.2 C 27.1 -140.9 54.2 -102.9 78.3 -67.6 Z', to: 'M 58.3 -47 C 72.3 -29 78 -4.9 69.3 8.7 C 60.5 22.4 37.2 25.6 13 43.6 C -11.1 61.6 -36.2 94.3 -65 95.5 C -93.8 96.8 -126.3 66.5 -133.3 31.6 C -140.3 -3.3 -121.8 -42.8 -95.3 -63.7 C -68.8 -84.5 -34.4 -86.8 -6.1 -81.9 C 22.2 -77 44.3 -65 58.3 -47 Z', dur: '5s' },
  { d: 'M 124.8 -128.3 C 130.8 -118.8 83.4 -59.4 56.8 -26.6 C 30.1 6.1 24.3 12.3 18.3 54.9 C 12.3 97.6 6.1 176.8 -7 183.7 C -20 190.7 -40.1 125.4 -63.6 82.7 C -87.1 40.1 -114 20 -122.8 -8.7 C -131.5 -37.5 -122 -75 -98.5 -84.5 C -75 -94 -37.5 -75.5 11 -86.4 C 59.4 -97.4 118.8 -137.8 124.8 -128.3 Z', to: 'M 53.9 -49.2 C 67.2 -40.5 73.6 -20.3 72.4 -1.2 C 71.2 17.9 62.5 35.8 49.2 83.8 C 35.8 131.8 17.9 209.9 -7.4 217.3 C -32.8 224.8 -65.5 161.5 -107.7 113.5 C -149.9 65.5 -201.4 32.8 -188.8 12.6 C -176.2 -7.5 -99.4 -15.1 -57.3 -23.8 C -15.1 -32.4 -7.5 -42.2 6.4 -48.6 C 20.3 -54.9 40.5 -57.9 53.9 -49.2 Z', dur: '4.4s' },
  { d: 'M 42.7 -33.9 C 61.9 -23.6 88.5 -11.8 113.6 25.1 C 138.7 62 162.3 124 143.1 129.8 C 124 135.6 62 85.3 16.7 68.6 C -28.5 51.9 -57 68.7 -90 62.9 C -123 57 -160.5 28.5 -151 9.5 C -141.4 -9.4 -84.9 -18.9 -51.9 -29.2 C -18.9 -39.5 -9.4 -50.8 1.2 -51.9 C 11.8 -53.1 23.6 -44.2 42.7 -33.9 Z', to: 'M 124.8 -128.3 C 130.8 -118.8 83.4 -59.4 56.8 -26.6 C 30.1 6.1 24.3 12.3 18.3 54.9 C 12.3 97.6 6.1 176.8 -7 183.7 C -20 190.7 -40.1 125.4 -63.6 82.7 C -87.1 40.1 -114 20 -122.8 -8.7 C -131.5 -37.5 -122 -75 -98.5 -84.5 C -75 -94 -37.5 -75.5 11 -86.4 C 59.4 -97.4 118.8 -137.8 124.8 -128.3 Z', dur: '5.4s' },
];
// раскладка ленты — как в пене: путь-капля, размер svg, слой параллакса
const BLOB_LAYOUT = [
  { path: 1, size: 560, cls: '' },
  { path: 2, size: 660, cls: '--special' },
  { path: 3, size: 560, cls: '--special1' },
  { path: 4, size: 560, cls: '--special3' },
  { path: 5, size: 660, cls: '--special4' },
  { path: 6, size: 720, cls: '--special1' },
  { path: 7, size: 800, cls: '' },
  { path: 1, size: 660, cls: '' },
  { path: 2, size: 400, cls: '--special2' },
  { path: 4, size: 560, cls: '' },
  { path: 6, size: 660, cls: '--special' },
  { path: 3, size: 720, cls: '--special4' },
];
// квадратный кроп 900×900 — как исходники в пене (иначе slice в viewBox 600×600 сильно зумит кадр)
const heroUrls = await Promise.all(
  pages['our-world'].heroCarousel.map(async (n: string) => {
    const m = img(n);
    return m ? (await getImage({ src: m, width: 900, height: 900, fit: 'cover', format: 'webp' })).src : '';
  }),
);
const blobItems = BLOB_LAYOUT.map((b, i) => ({ ...b, url: heroUrls[i % heroUrls.length] })).filter((b) => b.url);

const c = site.contacts;
const booking = site.contacts.bookingHref;
const socialLabels: Record<string, string> = {
  vk: 'ВКонтакте', whatsapp: 'WhatsApp', tiktok: 'TikTok',
  instagram: 'Instagram', telegram: 'Telegram', youtube: 'YouTube', rutube: 'RUTUBE',
};

// меню — как на главной; «Наш мир» = текущая страница
const navMenu = [
  { t: 'Главная', href: withBase('/') },
  { t: 'Дома', href: withBase('/accommodation/house-1') },
  { t: 'Искусство отдыха', href: withBase('/art-of-rest') },
  { t: 'Атмосфера для двоих', href: withBase('/atmosphere/') },
  { t: 'Наш мир', href: withBase('/our-world/') },
  { t: 'Истории', href: withBase('/stories/') },
];
---
<SiteLayout title="Наш мир — Парк Север">
  <!-- NAV -->
  <nav class="nav">
    <div class="wrap">
      <a class="nav__logo" href={withBase('/')}><LogoMark class="nav__logo-mark" />Парк Север</a>
      <button class="nav__toggle" aria-label="Открыть меню">
        <span></span><span></span><span></span>
      </button>
      <div class="nav__menu">
        {navMenu.map((m) => <a href={m.href}>{m.t}</a>)}
      </div>
      <a class="nav__book" href={booking}>Забронировать</a>
    </div>
  </nav>

  <!-- Карусель вверху (фото 1.1–1.6 по ТЗ) + интро -->
  <section class="sec ow-hero" id="ow-hero">
    <div class="wrap wrap--flush">
      <h1 class="h1 ow-hero__title">Наш мир</h1>
    </div>
    <!-- Blob-карусель (по ТЗ: codepen.io/pehaa/pen/QYeqBO — «капли» с морфингом, бесконечная лента, параллакс) -->
    <div class="ow-blob">
      <svg width="0" height="0" viewBox="0 0 600 600" class="ow-blob__defs" aria-hidden="true" focusable="false">
        <defs>
          {BLOBS.map((b, i) => (
            <clipPath id={'ow-path-' + (i + 1)} transform="translate(300,300)">
              <path d={b.d}>
                <animate attributeName="d" dur={b.dur} repeatCount="indefinite" calcMode="linear" values={`${b.d};${b.to};${b.d}`} />
              </path>
            </clipPath>
          ))}
        </defs>
      </svg>
      <div class="ow-blob__outer">
        <section class="ow-blob__ctnr" id="ow-blob-track">
          {blobItems.map((it) => (
            <div class={'ow-blob__div' + (it.cls ? ' ow-blob__div' + it.cls : '')}>
              <svg class="ow-blob__svg" width={it.size + 'px'} height={it.size + 'px'} viewBox="0 0 600 600" preserveAspectRatio="xMidYMid slice">
                <g clip-path={`url(#ow-path-${it.path})`}>
                  <image href={it.url} x="0" y="0" width="100%" height="100%" preserveAspectRatio="xMidYMid slice" />
                </g>
              </svg>
            </div>
          ))}
        </section>
      </div>
    </div>
    <div class="wrap wrap--flush">
      <p class="ow-hero__lead">{ow.intro}</p>
    </div>
  </section>

  <!-- Горизонтальное меню разделов (слева по ТЗ) -->
  <div class="ow-menubar" id="ow-menubar">
    <div class="wrap wrap--flush">
      <nav class="ow-menu" aria-label="Разделы «Наш мир»">
        {ow.menu.map((m: any, i: number) => (
          <a href={'#' + m.id} data-ow-tab={m.id} class={i === 0 ? 'is-active' : ''}>{m.label}</a>
        ))}
      </nav>
    </div>
  </div>

  <!-- О НАС: кто стоит за Парк Север (правка заказчицы 02.09, текст из докса дословно) -->
  <section class="sec ow-section" id="about" data-ow-panel="about">
    <div class="wrap wrap--flush">
      <div class="split2 ow-split ow-split--about">
        <div>
          <h2 class="h2">{ow.about.heading}</h2>
          <p class="ow-par">{ow.about.intro}</p>
          {ow.about.paragraphsBefore.map((p: string) => <p class="ow-par" set:html={p} />)}
          {ow.about.notLines.map((p: string) => <p class="ow-par">{p}</p>)}
          {ow.about.paragraphsAfter.map((p: string) => <p class="ow-par" set:html={p} />)}
        </div>
        {ow.about.photo && img(ow.about.photo) && (
          <div class="ow-photo ow-photo--owner">
            <Image src={img(ow.about.photo)!} alt="Екатерина Валова с оленями фермы «Благородный Север»" widths={[420, 600]} sizes="(max-width:860px) 90vw, 420px" />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- РЕТРИВЕРЫ -->
  <section class="sec ow-section" id="retrievers" data-ow-panel="retrievers" hidden>
    <div class="wrap wrap--flush">
      <div class="split2 ow-split">
        <div>
          <h2 class="h2">{ow.retrievers.heading}</h2>
          {ow.retrievers.paragraphs.map((p: string) => <p class="ow-par">{p}</p>)}
        </div>
        {img(ow.retrievers.ownerPhoto) && (
          <div class="ow-photo ow-photo--owner">
            <Image src={img(ow.retrievers.ownerPhoto)!} alt="Хозяйка парка с ретриверами на террасе" widths={[420, 600]} sizes="(max-width:860px) 90vw, 420px" />
          </div>
        )}
      </div>

      <h3 class="h3 ow-subhead">Наши собаки</h3>
      <div class="ow-dogs" id="ow-dogs">
        {ow.retrievers.dogs.map((d: any) => (
          <article class="ow-dog">
            <div class="ow-dog__inner">
              <div class="ow-dog__front">
                {img(d.photo) && <Image src={img(d.photo)!} alt={d.name} widths={[500, 800]} sizes="(max-width:860px) 100vw, 30vw" />}
                <h4 class="ow-dog__name">{d.name}</h4>
              </div>
              <div class="ow-dog__back">
                <h4 class="ow-dog__name ow-dog__name--back">{d.name}</h4>
                {d.paragraphs.map((p: string) => <p>{p}</p>)}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="wrap wrap--flush">
      <div class="ow-strip" data-carousel>
        <div class="ow-strip__track oasis-carousel__track">
          {ow.retrievers.gallery.map((name: string) => {
            const m = img(name);
            return m ? (
              <figure class="ow-strip__item">
                <Image src={m} alt="Золотистые ретриверы Парка Север" widths={[500, 900]} sizes="30vw" />
              </figure>
            ) : null;
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- ЛЕС -->
  <section class="sec ow-section" id="forest" data-ow-panel="forest" hidden>
    <div class="wrap wrap--flush">
      <h2 class="h2">{ow.forest.territory.heading}</h2>
      <div class="ow-cols">
        {ow.forest.territory.paragraphs.map((p: string) => <p class="ow-par">{p}</p>)}
      </div>
    </div>
    <div class="wrap wrap--flush">
      <div class="ow-strip" data-carousel>
        <div class="ow-strip__track oasis-carousel__track">
          {ow.forest.territory.photos.map((name: string) => {
            const m = img(name);
            return m ? (
              <figure class="ow-strip__item">
                <Image src={m} alt="Лес и территория Парка Север" widths={[500, 900]} sizes="30vw" />
              </figure>
            ) : null;
          })}
        </div>
      </div>
    </div>

    <div class="wrap wrap--flush ow-animals">
      <h2 class="h2">{ow.forest.animals.heading}</h2>
      <div class="ow-cols">
        {ow.forest.animals.paragraphs.map((p: string) => <p class="ow-par">{p}</p>)}
      </div>
      {ow.forest.animals.groups.map((g: any) => (
        <div class="ow-animal-group">
          <h3 class="h3 ow-subhead">{g.title}</h3>
          <div class="ow-strip" data-carousel>
            <div class="ow-strip__track oasis-carousel__track">
              {g.items.map((it: any) => {
                const m = img(it.photo);
                return m ? (
                  <figure class="ow-strip__item ow-strip__item--sm">
                    <Image src={m} alt={it.caption} widths={[400, 700]} sizes="22vw" />
                    <figcaption class="ow-cap">{it.caption}</figcaption>
                  </figure>
                ) : null;
              })}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ПРУД -->
  <section class="sec ow-section" id="pond" data-ow-panel="pond" hidden>
    <div class="wrap wrap--flush">
      <div class="split2 ow-split">
        <div>
          <h2 class="h2">{ow.pond.heading}</h2>
          {ow.pond.paragraphs.map((p: string) => <p class="ow-par">{p}</p>)}
        </div>
        <div class="ow-photo-stack">
          {ow.pond.photos.map((name: string) => {
            const m = img(name);
            return m ? <div class="ow-photo"><Image src={m} alt={ow.pond.heading} widths={[600, 1000]} sizes="(max-width:860px) 100vw, 46vw" /></div> : null;
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- ВЕЛОСИПЕДЫ -->
  <section class="sec ow-section" id="bikes" data-ow-panel="bikes" hidden>
    <div class="wrap wrap--flush">
      <h2 class="h2">{ow.bikes.heading}</h2>
      <div class="ow-cols">
        {ow.bikes.paragraphs.map((p: string) => <p class="ow-par">{p}</p>)}
      </div>
    </div>
    <div class="wrap wrap--flush">
      <div class="ow-strip" data-carousel>
        <div class="ow-strip__track oasis-carousel__track">
          {ow.bikes.photos.map((name: string) => {
            const m = img(name);
            return m ? (
              <figure class="ow-strip__item">
                <Image src={m} alt={ow.bikes.heading} widths={[500, 900]} sizes="30vw" />
              </figure>
            ) : null;
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- ОЛЕНИ -->
  <section class="sec ow-section" id="deer" data-ow-panel="deer" hidden>
    <div class="wrap wrap--flush">
      <h2 class="h2">{ow.deer.heading}</h2>
      <div class="ow-cols">
        {ow.deer.paragraphs.map((p: string) => <p class="ow-par">{p}</p>)}
      </div>
      <div class="ow-deer-photos">
        {ow.deer.photos.map((name: string) => {
          const m = img(name);
          return m ? <div class="ow-photo"><Image src={m} alt="Ферма «Благородный север»" widths={[500, 900]} sizes="(max-width:860px) 100vw, 32vw" /></div> : null;
        })}
      </div>
      <p class="ow-par ow-deer-note">{ow.deer.note}</p>
      <div class="ow-links">
        {ow.deer.links.map((l: any) => (
          <a class="btn btn--navy" href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- ИНТЕРЕСНЫЕ МЕСТА РЯДОМ -->
  <section class="sec ow-section" id="places" data-ow-panel="places" hidden>
    <div class="wrap wrap--flush">
      <h2 class="h2">{ow.places.heading}</h2>
      <p class="ow-par ow-places-intro">{ow.places.intro}</p>
      <div class="ow-places">
        {ow.places.items.map((pl: any, i: number) => {
          const m = img(pl.photo);
          return (
            <div class={'split2 ow-place' + (i % 2 === 1 ? ' split2--rev' : '')}>
              <div class="ow-place__text">
                <h3 class="h3 ow-place__title">{pl.title}: {pl.subtitle.replace(/\.$/, '')}</h3>
                <p class="ow-par">{pl.text}</p>
                {pl.address && <p class="ow-par ow-place__addr">{pl.address}</p>}
                <a class="btn btn--navy" href={pl.route} target="_blank" rel="noopener noreferrer">Построить маршрут</a>
              </div>
              {m && <div class="ow-photo"><Image src={m} alt={pl.title} widths={[600, 1000]} sizes="(max-width:860px) 100vw, 46vw" /></div>}
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- FOOTER -->
