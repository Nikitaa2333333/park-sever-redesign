---
import SiteLayout from '../layouts/SiteLayout.astro';
import { site, withBase } from '../lib/content';

// «Правовая информация» — формальные документы старого сайта (URL сохранён 1:1).
// Контент — дословно из content/pages/legal-information.json, инлайном.
const c = site.contacts;
const booking = site.contacts.bookingHref;

const socialLabels: Record<string, string> = {
  vk: 'ВКонтакте', whatsapp: 'WhatsApp', tiktok: 'TikTok',
  instagram: 'Instagram', telegram: 'Telegram', youtube: 'YouTube', rutube: 'RUTUBE',
};

const navMenu = [
  { t: 'Главная', href: withBase('/') },
  { t: 'Дома', href: withBase('/accommodation/house-1') },
  { t: 'Искусство отдыха', href: withBase('/art-of-rest') },
  { t: 'Атмосфера для двоих', href: withBase('/atmosphere/') },
  { t: 'Наш мир', href: withBase('/our-world/') },
  { t: 'Истории', href: withBase('/stories/') },
];

const docs = [
  { title: 'Договор-оферта', href: withBase('/files/Договор-оферта.pdf') },
  { title: 'Правила проживания', href: withBase('/files/Правила-проживания.pdf') },
];

// Phosphor Icons, Fill: file-text
const iconDoc = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor" width="100%" height="100%"><path d="M213.66,82.34l-56-56A8,8,0,0,0,152,24H56A16,16,0,0,0,40,40V216a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V88A8,8,0,0,0,213.66,82.34ZM160,176H96a8,8,0,0,1,0-16h64a8,8,0,0,1,0,16Zm0-32H96a8,8,0,0,1,0-16h64a8,8,0,0,1,0,16ZM152,88V44l44,44Z"/></svg>';
---
<SiteLayout title="Правовая информация — Парк Север">
  <!-- NAV -->
  <nav class="nav">
    <div class="wrap">
      <a class="nav__logo" href={withBase('/')}>Парк Север</a>
      <button class="nav__toggle" aria-label="Открыть меню">
        <span></span><span></span><span></span>
      </button>
      <div class="nav__menu">
        {navMenu.map((m) => <a href={m.href}>{m.t}</a>)}
      </div>
      <a class="nav__book" href={booking}>Забронировать</a>
    </div>
  </nav>

  <section class="sec" id="legal">
    <div class="wrap wrap--flush">
      <h1 class="h1">Правовая информация</h1>

      <div class="legal-col">
        <h2 class="legal-h">Документы</h2>
        <div class="legal-docs">
          {docs.map((d) => (
            <a class="legal-doc" href={d.href} target="_blank" rel="noopener noreferrer">
              <span class="legal-doc__icon" set:html={iconDoc} />
              <span class="legal-doc__body">
                <span class="legal-doc__t">{d.title}</span>
                <span class="legal-doc__open">Открыть PDF</span>
              </span>
            </a>
          ))}
        </div>

        <h2 class="legal-h">Реквизиты</h2>
        <dl class="legal-req">
          <dt>Наименование</dt><dd>{site.requisites.entity}</dd>
          <dt>ИНН</dt><dd>{site.requisites.inn}</dd>
        </dl>
        <p class="legal-note">{site.requisites.note}</p>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="foot">
    <div class="wrap wrap--flush">
      <div class="foot__cols">
        <div>
          <div class="foot__brand">Парк Север</div>
          <p class="foot__about">Пространство на краю леса для тех, кто выбирает тишину. Приватный дом без потока людей и лишнего, на территории 12,4 га. Без соседей. Только природа, животные и ощущение, что никуда не нужно спешить.</p>
          <div class="socials">
            {site.socials.map((s: any) => <a href={s.href} target="_blank" rel="noopener noreferrer">{socialLabels[s.type] ?? s.type}</a>)}
          </div>
        </div>
        <div class="foot__col">
          <h4>Разделы</h4>
          {navMenu.map((m) => <a href={m.href}>{m.t}</a>)}
        </div>
        <div class="foot__col">
          <h4>Контакты</h4>
          <a href={c.phoneHref}>{c.phone}</a>
          <a href={c.emailHref}>{c.email}</a>
          <a href={c.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
          <span class="foot__addr">{c.address}</span>
        </div>
        <div class="foot__col">
          <h4>Документы</h4>
          <a href={withBase('/legal-information')}>Правовая информация</a>
          <a href={withBase('/files/Договор-оферта.pdf')} target="_blank" rel="noopener noreferrer">Договор-оферта (PDF)</a>
          <a href={withBase('/files/Правила-проживания.pdf')} target="_blank" rel="noopener noreferrer">Правила проживания (PDF)</a>
        </div>
      </div>
      <hr class="foot__rule" />
      <div class="foot__cp">© {site.company} · {site.requisites.entity} · {site.requisites.note}</div>
    </div>
  </footer>

  <style>
    /* воздух под фиксированной шапкой (56px) — заголовок не утыкается в неё */
    #legal{ padding-top:calc(56px + 48px); }

    /* Узкая редакционная колонка на левой линии */
    .legal-col{ max-width:760px; margin-top:8px; }

    .legal-h{
      font-family:var(--font-head); font-weight:600;
      font-size:clamp(21px,2.2vw,26px); line-height:1.25; color:var(--ink);
      margin:56px 0 20px;
    }

    /* Документы — светлые cream-карточки, глубина контрастом поверхностей */
    .legal-docs{ display:grid; grid-template-columns:repeat(2,1fr); gap:20px; }
    .legal-doc{
      display:flex; align-items:center; gap:18px;
      background:var(--cream); padding:26px 28px;
      color:var(--ink); text-decoration:none;
    }
    .legal-doc__icon{ flex:0 0 40px; width:40px; height:40px; color:var(--gold-l); }
    .legal-doc__body{ display:flex; flex-direction:column; gap:4px; }
    .legal-doc__t{ font-family:var(--font-head); font-weight:600; font-size:18px; line-height:1.35; }
    .legal-doc__open{
      font-family:var(--font-head); font-weight:500; font-size:16px; color:var(--ink);
      text-decoration:underline; text-underline-offset:3px;
    }
    .legal-doc:hover .legal-doc__open{ text-decoration:none; }

    /* Реквизиты — строки «ярлык — значение», без декоративных линий */
    .legal-req{ display:grid; grid-template-columns:180px 1fr; row-gap:10px; column-gap:24px; margin:0; }
    .legal-req dt{ font-family:var(--font-head); font-weight:600; font-size:18px; line-height:1.5; color:var(--ink); }
    .legal-req dd{ font-family:var(--font-body); font-weight:500; font-size:18px; line-height:1.5; color:var(--ink); margin:0; }
    .legal-note{
      font-family:var(--font-body); font-weight:500; font-size:16px; line-height:1.55;
      color:var(--ink); max-width:62ch; margin:20px 0 0;
    }

    @media(max-width:640px){
      .legal-docs{ grid-template-columns:1fr; }
      .legal-req{ grid-template-columns:1fr; row-gap:2px; }
      .legal-req dd{ margin-bottom:10px; }
    }
  </style>
</SiteLayout>
