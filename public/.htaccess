# Парк Север — кэш статики и сжатие (Reg.ru, Apache).
# Цель: PageSpeed «Use efficient cache lifetimes» — ассеты отдавались с Cache-Control: none.
# HTML НЕ кэшируем надолго (он меняется при каждом деплое) — только статику.

# --- Долгий кэш для статики ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType video/mp4              "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Ассеты с хешем в имени (/_astro/*) и локальные шрифты — можно immutable на год:
  # при изменении меняется имя файла, так что устаревшего кэша не будет.
  <FilesMatch "\.(webp|jpe?g|png|svg|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.mp4$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML — короткий кэш, чтобы правки сайта появлялись сразу.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Сжатие (gzip) для текстовых ресурсов ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Один адрес сайта и старые URL (SEO, 27.10.2026) ---
# Своя страница 404 (dist/404.html) — с кодом 404, поисковик убирает такие адреса из индекса.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # www.park-sever.ru → park-sever.ru (иначе в поиске две копии сайта)
  RewriteCond %{HTTP_HOST} ^www\.park-sever\.ru$ [NC]
  RewriteRule ^(.*)$ https://park-sever.ru/$1 [R=301,L]
  # /index.html → / (дубль главной)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ / [R=301,L]
  # Адреса прежнего сайта (content/seo.json) → ближайшие страницы нового (301):
  # вес страниц в поиске переходит на новые, а не теряется на 404.
  RewriteRule ^about/?$ /our-world/ [R=301,L]
  RewriteRule ^entertainment/?$ /our-world/ [R=301,L]
  RewriteRule ^(new-year|february|special-offers)/?$ /atmosphere/ [R=301,L]
  RewriteRule ^news/?$ /stories/ [R=301,L]
  RewriteRule ^(contacts|pay)/?$ / [R=301,L]
  RewriteRule ^accommodation/house-[23]/?$ /accommodation/house-1/ [R=301,L]
</IfModule>
